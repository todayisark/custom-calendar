{
  "name": "custom-calendar-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "shadcn build",
    "build-storybook": "storybook build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --project=unit",
    "test:browser": "vitest run --project=storybook",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-unused-imports": "latest",
    "globals": "latest",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "prettier": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "shadcn": "latest",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "latest",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
