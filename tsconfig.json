{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "examples/**/*.tsx",
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "vitest.config.ts"
  ]
}
